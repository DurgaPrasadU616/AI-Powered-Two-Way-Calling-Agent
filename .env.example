# ============================================================
# AI-Powered Two-Way Calling Agent — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
POSTGRES_USER=calling_agent
POSTGRES_PASSWORD=secret
POSTGRES_DB=calling_agent_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://calling_agent:secret@localhost:5432/calling_agent_db

# ── App ───────────────────────────────────────────────────
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-32-char-string-in-production

# ── Admin account (env-configured, no DB signup) ──────────
ADMIN_EMAIL=admin@sephawk.com
ADMIN_PASSWORD=Admin@123

# ── JWT ───────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── LLM (Google Gemini — free tier via AI Studio) ─────────
GEMINI_API_KEY=your-gemini-api-key-here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ── STT ───────────────────────────────────────────────────
# browser = Web Speech API (default demo, free)
# whisper = faster-whisper backend (Phase 4+)
STT_PROVIDER=browser

# ── TTS ───────────────────────────────────────────────────
# browser = speechSynthesis (default demo, free)
# edge   = edge-tts backend (Phase 4+)
TTS_PROVIDER=browser

# ── Failure simulation (dev/demo only: stt | llm | provider) ─────────
SIMULATE_FAILURE=

# ── Calling provider ──────────────────────────────────────
# browser = WebSocket/WebRTC (default demo)
# twilio  = Twilio trial (Phase 7, optional)
CALL_PROVIDER=browser

# ── CORS ──────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:3000

# ── Twilio (optional — Phase 7) ───────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
